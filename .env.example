# Copy to .env and fill in values. Never commit .env.

# Database (Neon, use the pooled connection string)
DATABASE_URI=

# Payload
PAYLOAD_SECRET=

# Site
NEXT_PUBLIC_SERVER_URL=

# File storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# Email: Resend (production and preview)
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# Email: Mailpit (local development)
SMTP_HOST=
SMTP_PORT=

# Bot protection (Cloudflare Turnstile)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Errors (Sentry)
SENTRY_DSN=
# Same value as SENTRY_DSN (the browser needs a NEXT_PUBLIC_ variable)
NEXT_PUBLIC_SENTRY_DSN=
# Only for uploading source maps at build time (CI / Vercel)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Seed (development only)
SEED_PASSWORD=

# Background jobs: Vercel Cron sends this as a Bearer token to /api/payload-jobs/run
CRON_SECRET=
